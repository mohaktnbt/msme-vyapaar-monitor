# ============================================================
# MSME Vyapaar Monitor — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys
# Get free tiers at the URLs mentioned below

# ------------------------------------------------------------
# AI — Groq (free tier: 14,400 req/day)
# Sign up at: https://console.groq.com
# ------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------
# Cache — Upstash Redis (free tier: 10,000 req/day)
# Sign up at: https://upstash.com
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# Government Data — data.gov.in (free API key)
# Register at: https://data.gov.in/user/register
# ------------------------------------------------------------
DATA_GOV_API_KEY=

# ------------------------------------------------------------
# GeM API (optional — for authenticated partner access)
# Apply at: https://gem.gov.in/docs/api
# Without this, we fall back to public bid page scraping
# ------------------------------------------------------------
GEM_API_KEY=
GEM_APP_SECRET=

# ------------------------------------------------------------
# GitHub Token (for GitHub Actions cron scrapers)
# Create at: https://github.com/settings/tokens
# Scopes: repo, workflow
# ------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------
# IUDX Smart Cities API (optional)
# Register at: https://iudx.org.in/register
# ------------------------------------------------------------
IUDX_API_KEY=

# ------------------------------------------------------------
# Private Circle API (optional — paid, for VC funding data)
# https://app.privatecircle.co/api
# ------------------------------------------------------------
PRIVATE_CIRCLE_API_KEY=

# ------------------------------------------------------------
# PrivateCircle (optional)
# ------------------------------------------------------------
PRIVATECIRCLE_API_KEY=

# ------------------------------------------------------------
# Vercel KV (alternative to Upstash Redis if deploying to Vercel)
# Auto-set by Vercel when you add KV Storage to project
# ------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------
# Set to "production" or "development"
NODE_ENV=development

# Vite exposes only VITE_ prefixed vars to the browser
# These are safe to expose (public API keys or endpoints)
VITE_GROQ_API_KEY=
VITE_DATA_GOV_API_KEY=
VITE_APP_ENV=development
